# ==========================================
# Second Opinion - Environment Configuration
# ==========================================

# -----------------
# Application Mode
# -----------------
APP_ENV=development
DEBUG=true

# -----------------
# Backend (FastAPI)
# -----------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Connection
# SQLite (default for quick zero-config local run):
DATABASE_URL=sqlite:///./second_opinion.db
# PostgreSQL (production / Docker Compose):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/second_opinion

# Uploads Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB limit
ALLOWED_EXTENSIONS=pdf,txt,md

# Feature Flags
ENABLE_MOCK_VERIFICATION=true
VERIFICATION_PROVIDER=deterministic # options: deterministic, mock, nli, llm
MIN_EVIDENCE_RELEVANCE=0.20

# Neural NLI Model Configuration (HuggingFace CrossEncoder)
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small
NLI_DEVICE=cpu
NLI_ENTAILMENT_THRESHOLD=0.65
NLI_CONTRADICTION_THRESHOLD=0.65
NLI_NEUTRAL_THRESHOLD=0.50

# -----------------
# External AI / LLM Providers (Optional / Future Phases)
# Configure these when implementing real claim extraction and verification.
# -----------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------
# Frontend (Vite)
# -----------------
VITE_API_URL=http://localhost:8000/api
